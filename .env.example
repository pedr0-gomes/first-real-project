# Copie para .env.local (gitignored) e preencha com as chaves do projeto.
# Settings → API no dashboard do Supabase.

# Project URL — não é segredo (é https://<reference-id>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://czgpumkagzmtuyzgryye.supabase.co

# Publishable key (sb_publishable_...) — pode ir pro browser; respeita RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_...) — NÃO usar ainda. Fura RLS (admin). Server-only.
# SUPABASE_SECRET_KEY=sb_secret_xxx
